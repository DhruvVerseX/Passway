{
    "name": "@passway/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "tsx --env-file=.env src/index.ts",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "test": "vitest run"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.6.25",
        "@neondatabase/serverless": "^1.1.0",
        "better-auth": "^1.6.25",
        "drizzle-orm": "^0.45.2",
        "express": "^4.19.2",
        "resend": "^6.18.1",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.14.0",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.16.0",
        "typescript": "^5.5.0",
        "vitest": "^4.1.10"
    }
}

{
  "name": "passway-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "bun --cwd apps/web run dev",
    "dev:app": "bun --cwd apps/app run dev",
    "dev:docs": "bun --cwd apps/docs run dev",
    "build:frontends": "bun --cwd apps/web run build && bun --cwd apps/app run build && bun --cwd apps/docs run build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}

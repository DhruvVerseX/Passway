{
  "name": "passway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "build:frontends": "bun run --cwd apps/web build && bun run --cwd apps/dashboard build",
    "start": "bun run --cwd apps/api start",
    "token:generate": "bun scripts/generate-token.ts",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd packages/cli typecheck",
    "test:cli": "bun run --cwd packages/cli test"
  }
}

{
  "name": "@passway/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "passway": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "PASSWAY_API_URL=http://localhost:4000 bun --cwd ../.. packages/cli/src/index.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepack": "bun run build"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
